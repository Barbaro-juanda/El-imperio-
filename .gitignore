# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editores
*.swp
*~

# Dependencias
node_modules/

# Secretos locales. NUNCA al repositorio: es público, y aquí viven la clave
# del panel y la cadena de conexión a la base. Git guarda el historial para
# siempre, así que un commit por error no se arregla borrando el archivo.
.env
.env.*
!.env.example

# Vercel CLI
.vercel/

# Respaldos de la base. Llevan nombres y teléfonos de clientes reales y este
# repositorio es público: un respaldo aquí dentro es una filtración, y Git
# guarda el historial para siempre, así que no se arregla borrando el archivo.
respaldos/
.vercel
.env*
