# Plantilla de las variables que necesita el proyecto.
# Copiar a .env.development.local y rellenar. Este archivo SÍ va al repositorio;
# el otro no, y por eso aquí solo hay descripciones, nunca valores.

# Conexión a Postgres. La inyecta Vercel en producción; en local la trae
# "npx vercel env pull .env.development.local".
DATABASE_URL=

# Clave que teclea el local para entrar a /panel.html
PANEL_CLAVE=

# Cadena aleatoria para firmar la cookie de sesión. Nadie la teclea.
# Generar con: openssl rand -base64 32
PANEL_SECRETO=
